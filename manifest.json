{
  "manifest_version": 3,
  "name": "GitLab MR → Slack",
  "version": "1.0.0",
  "description": "Select Merge Requests with checkboxes in the GitLab list and send them to Slack (Incoming Webhook) or copy them using a template.",
  "permissions": ["storage", "scripting", "declarativeNetRequest"],
  "host_permissions": ["https://hooks.slack.com/*"],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitLab MR → Slack: message settings"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["open.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
